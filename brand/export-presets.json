    },
    {
      "name": "banner-dark",
      "source": "templates/banner-dark.svg",
      "output": "exports/banner-dark.png",
      "width": 1500,
      "height": 500,
      "background": "#16151B"
    },
    {
      "name": "social-preview-light",
      "source": "templates/social-preview-light.svg",
      "output": "exports/social-preview-light.png",
      "width": 1280,
      "height": 640,
      "background": "#F2F1F6"
    },
    {
      "name": "avatar-light",
      "source": "templates/avatar-light.svg",
      "output": "exports/avatar-light.png",
      "width": 512,
      "height": 512,
      "background": "#F2F1F6"
    },
    {
      "name": "banner-light",
      "source": "templates/banner-light.svg",
      "output": "exports/banner-light.png",
      "width": 1500,
      "height": 500,
      "background": "#F2F1F6"
    }
